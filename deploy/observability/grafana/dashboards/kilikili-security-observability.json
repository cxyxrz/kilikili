          "expr": "sum by (statement) (increase(kilikili_sql_slow_total[$__rate_interval]))",
          "legendFormat": "{{statement}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
