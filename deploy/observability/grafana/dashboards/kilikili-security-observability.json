            "axisCenteredZero": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "gradientMode": "none",
            "insertNulls": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "各 Mapper 平均 SQL 耗时",
      "description": "kilikili.sql.duration 的 sum/count 比值，单位毫秒",
      "datasource": { "type": "prometheus", "uid": "kilikili-prometheus" },
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "kilikili-prometheus" },
          "expr": "1000 * sum by (statement) (rate(kilikili_sql_duration_seconds_sum[$__rate_interval])) / clamp_min(sum by (statement) (rate(kilikili_sql_duration_seconds_count[$__rate_interval])), 0.001)",
          "legendFormat": "{{statement}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
