            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "axisCenteredZero": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "gradientMode": "none",
            "insertNulls": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "" },
            "thresholdsStyle": {
              "mode": "dashed",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 200 },
                { "color": "red", "value": 500 }
              ]
            },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
